{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Transcribed from https://cursor.com/docs/agent/hooks and https://cursor.com/docs/reference/plugins (hook events and command entries).",
  "type": "object",
  "required": ["hooks"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 1},
    "hooks": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "sessionStart", "sessionEnd", "preToolUse", "postToolUse", "postToolUseFailure", "subagentStart",
          "subagentStop", "beforeShellExecution", "afterShellExecution", "beforeMCPExecution",
          "afterMCPExecution", "beforeReadFile", "afterFileEdit", "beforeSubmitPrompt", "preCompact", "stop",
          "afterAgentResponse", "afterAgentThought", "workspaceOpen"
        ]
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["command"],
          "additionalProperties": false,
          "properties": {
            "command": {"type": "string", "minLength": 1},
            "matcher": {"type": "string"},
            "timeout": {"type": "number", "exclusiveMinimum": 0},
            "failClosed": {"type": "boolean"},
            "loop_limit": {"type": ["integer", "null"]}
          }
        }
      }
    }
  }
}
