{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Transcribed from https://cursor.com/docs/reference/plugins (.cursor-plugin/plugin.json). Closed so a typo fails.",
  "type": "object",
  "required": ["name"],
  "additionalProperties": false,
  "$defs": {
    "relative": {"type": "string", "not": {"pattern": "^/|(^|/)\\.\\.(/|$)"}},
    "paths": {"oneOf": [{"$ref": "#/$defs/relative"}, {"type": "array", "items": {"$ref": "#/$defs/relative"}}]}
  },
  "properties": {
    "name": {"type": "string", "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"},
    "description": {"type": "string"},
    "version": {"type": "string"},
    "author": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {"name": {"type": "string"}, "email": {"type": "string"}}
    },
    "homepage": {"type": "string"},
    "repository": {"type": "string"},
    "license": {"type": "string"},
    "keywords": {"type": "array", "items": {"type": "string"}},
    "logo": {"type": "string"},
    "rules": {"$ref": "#/$defs/paths"},
    "agents": {"$ref": "#/$defs/paths"},
    "skills": {"$ref": "#/$defs/paths"},
    "commands": {"$ref": "#/$defs/paths"},
    "hooks": {"oneOf": [{"$ref": "#/$defs/relative"}, {"type": "object"}]},
    "mcpServers": {"oneOf": [{"$ref": "#/$defs/relative"}, {"type": "object"}]},
    "variables": {"type": "object"}
  }
}
