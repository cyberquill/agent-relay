{
  "version": 3,
  "selectors": {
    "composer": {
      "css": "div.aislash-editor-input[contenteditable='true']",
      "required": true,
      "purpose": "The chat composer input"
    },
    "send": {
      "css": ".send-with-mode .anysphere-icon-button",
      "required": true,
      "purpose": "Sends the composer text; the same button becomes Stop while a turn runs"
    },
    "stop": {
      "css": ".send-with-mode .codicon-debug-stop",
      "required": false,
      "purpose": "Stops the running turn; present only while a turn runs"
    },
    "new_chat": {
      "css": "a.codicon-add-two[aria-label^='New Agent']",
      "required": true,
      "purpose": "Opens a new chat in the composer"
    },
    "model_picker": {
      "css": "button:has(> .vscode-model-picker__trigger-text)",
      "required": true,
      "purpose": "Opens the model menu"
    },
    "model_option": {
      "css": "li[data-testid^='model-item-']",
      "required": false,
      "purpose": "One model in the open model menu"
    },
    "messages": {
      "css": ".conversations, [data-testid='composer-messages']",
      "required": true,
      "purpose": "The scrolling list of chat messages"
    },
    "assistant_message": {
      "css": "[data-message-role='ai'], .composer-ai-message",
      "required": false,
      "purpose": "One assistant reply inside the messages list"
    }
  }
}
